# =============================================================================
# VYAPARMITRA — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Google Gemini AI Studio API Configuration
# -----------------------------------------------------------------------------
# Instructions:
# 1. Generate an API key in Google AI Studio: https://aistudio.google.com/
# 2. Copy this template file as `.env` in the project root:
#    copy .env.example .env
# 3. Paste your real API key below (do NOT commit .env to version control):
GEMINI_API_KEY=your_gemini_api_key_here

# Supported model identifier:
# - gemini-2.5-flash (Recommended: fast, high accuracy, practical reasoning)
# - gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# 2. Supabase Cloud Configuration (Optional)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
